# Postgres container credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chokepoint
# Host-side port for the compose Postgres.
# Defaults to 15432 so it does not clash with a locally installed Postgres on 5432
# or other Docker projects; inside the Docker network the service still uses 5432.
POSTGRES_PORT=15432

# SQLAlchemy URL used by the app, alembic, and tests when run from your host machine.
# Inside the app container the host is `db` on port 5432 (set by docker-compose).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/chokepoint
